{
  "name": "osv-guard",
  "version": "0.6.0",
  "description": "Guard npm/pnpm/yarn/bun scripts and commands behind an OSV vulnerability check. No binary required.",
  "type": "module",
  "bin": {
    "osv-guard": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "hooks",
    ".claude-plugin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.js",
    "version": "npm run version:sync && git add -A",
    "prepublishOnly": "npm run version:sync && npm run build",
    "version:sync": "node scripts/sync-version.mjs"
  },
  "keywords": [
    "osv",
    "osv-scanner",
    "security",
    "vulnerability",
    "audit",
    "npm-run",
    "cve",
    "ghsa"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeka911/osv-guard.git"
  },
  "bugs": {
    "url": "https://github.com/jeka911/osv-guard/issues"
  },
  "homepage": "https://github.com/jeka911/osv-guard#readme",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
